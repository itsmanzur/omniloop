{
	"name": "omniloop/loop",
	"d4Shortcode": "ol_loop",
	"title": "OmniLoop Filter",
	"titles": "OmniLoop Filters",
	"category": "module",
	"moduleIcon": "omniloop/module-loop",
	"moduleClassName": "ol_loop",
	"moduleOrderClassName": "ol_loop",
	"attributes": {
		"module": {
			"type": "object",
			"selector": "{{selector}}",
			"default": {
				"meta": {
					"adminLabel": {
						"desktop": {
							"value": "OmniLoop Filter"
						}
					}
				},
				"advanced": {
					"postType": {
						"desktop": {
							"value": "post"
						}
					},
					"perPage": {
						"desktop": {
							"value": "12"
						}
					},
					"showFilters": {
						"desktop": {
							"value": "on"
						}
					},
					"columns": {
						"desktop": {
							"value": "3"
						}
					},
					"imageRatio": {
						"desktop": {
							"value": "4-3"
						}
					}
				}
			},
			"settings": {
				"meta": {
					"adminLabel": {}
				},
				"advanced": {
					"postType": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "loopQuery",
							"priority": 10,
							"render": true,
							"attrName": "module.advanced.postType",
							"label": "Post Type",
							"description": "Which public post type the faceted loop should query.",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false
							},
							"defaultAttr": {
								"desktop": {
									"value": "post"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/select",
								"props": {
									"options": {
										"post": {
											"label": "Posts"
										},
										"product": {
											"label": "Products"
										},
										"page": {
											"label": "Pages"
										}
									}
								}
							}
						}
					},
					"perPage": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "loopQuery",
							"priority": 20,
							"render": true,
							"attrName": "module.advanced.perPage",
							"label": "Per Page",
							"description": "How many items to show in the loop.",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false
							},
							"defaultAttr": {
								"desktop": {
									"value": "12"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/select",
								"props": {
									"options": {
										"6": { "label": "6" },
										"8": { "label": "8" },
										"12": { "label": "12" },
										"16": { "label": "16" },
										"24": { "label": "24" },
										"36": { "label": "36" },
										"48": { "label": "48" }
									}
								}
							}
						}
					},
					"showFilters": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "loopQuery",
							"priority": 30,
							"render": true,
							"attrName": "module.advanced.showFilters",
							"label": "Show Filters",
							"description": "Show the search and facet sidebar next to the loop.",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false
							},
							"defaultAttr": {
								"desktop": {
									"value": "on"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/toggle"
							}
						}
					},
					"columns": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "loopLayout",
							"priority": 10,
							"render": true,
							"attrName": "module.advanced.columns",
							"label": "Columns",
							"description": "Number of cards per row.",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false
							},
							"defaultAttr": {
								"desktop": {
									"value": "3"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/select",
								"props": {
									"options": {
										"2": { "label": "2 columns" },
										"3": { "label": "3 columns" },
										"4": { "label": "4 columns" }
									}
								}
							}
						}
					},
					"imageRatio": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "loopLayout",
							"priority": 20,
							"render": true,
							"attrName": "module.advanced.imageRatio",
							"label": "Image Ratio",
							"description": "Featured image crop for loop cards.",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false
							},
							"defaultAttr": {
								"desktop": {
									"value": "4-3"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/select",
								"props": {
									"options": {
										"4-3": { "label": "Landscape 4:3" },
										"16-9": { "label": "Wide 16:9" },
										"1-1": { "label": "Square 1:1" },
										"3-4": { "label": "Portrait 3:4" }
									}
								}
							}
						}
					}
				},
				"decoration": {
					"layout": {},
					"background": {},
					"sizing": {},
					"spacing": {},
					"border": {},
					"boxShadow": {},
					"filters": {},
					"transform": {},
					"animation": {},
					"overflow": {},
					"disabledOn": {},
					"transition": {},
					"position": {},
					"zIndex": {}
				}
			}
		}
	},
	"settings": {
		"content": "auto",
		"design": "auto",
		"advanced": "auto",
		"groups": {
			"loopQuery": {
				"panel": "content",
				"priority": 5,
				"groupName": "content",
				"multiElements": true,
				"component": {
					"name": "divi/composite",
					"props": {
						"groupLabel": "Loop Query",
						"preset": "content"
					}
				}
			},
			"loopLayout": {
				"panel": "design",
				"priority": 5,
				"groupName": "layout",
				"multiElements": true,
				"component": {
					"name": "divi/composite",
					"props": {
						"groupLabel": "Loop Layout",
						"clipboardCategory": "style"
					}
				}
			}
		}
	}
}

{
	"name": "omniloop/loop-item",
	"d4Shortcode": "ol_loop_item",
	"title": "OmniLoop Card Item",
	"titles": "OmniLoop Card Items",
	"category": "child-module",
	"moduleIcon": "omniloop/module-loop-item",
	"moduleClassName": "ol_loop_item",
	"moduleOrderClassName": "ol_loop_item",
	"childrenName": [],
	"attributes": {
		"module": {
			"type": "object",
			"selector": "{{selector}}",
			"default": {
				"meta": {
					"adminLabel": {
						"desktop": {
							"value": "Card Item"
						}
					}
				},
				"advanced": {
					"elementType": {
						"desktop": {
							"value": "title"
						}
					}
				}
			},
			"styleProps": {
				"spacing": {
					"important": true
				}
			},
			"settings": {
				"meta": {
					"adminLabel": {}
				},
				"advanced": {
					"elementType": {
						"groupType": "group-item",
						"item": {
							"groupSlug": "itemContent",
							"priority": 10,
							"render": true,
							"attrName": "module.advanced.elementType",
							"label": "Card Element",
							"description": "Which piece of the product/post card this item renders. Reorder items in the layers panel to change card layout.",
							"category": "configuration",
							"features": {
								"dynamicContent": false,
								"hover": false,
								"sticky": false,
								"responsive": false,
								"preset": "content"
							},
							"defaultAttr": {
								"desktop": {
									"value": "title"
								}
							},
							"component": {
								"type": "field",
								"name": "divi/select",
								"props": {
									"options": {
										"image": { "label": "Image" },
										"title": { "label": "Title" },
										"excerpt": { "label": "Excerpt" },
										"price": { "label": "Price" },
										"rating": { "label": "Rating" },
										"addToCart": { "label": "Add to Cart" },
										"quickView": { "label": "Quick View" }
									}
								}
							}
						}
					}
				},
				"decoration": {
					"spacing": {}
				}
			}
		}
	},
	"settings": {
		"content": "auto",
		"design": "auto",
		"advanced": "auto",
		"groups": {
			"itemContent": {
				"panel": "content",
				"priority": 5,
				"groupName": "content",
				"multiElements": true,
				"component": {
					"name": "divi/composite",
					"props": {
						"groupLabel": "Card Element",
						"preset": "content"
					}
				}
			}
		}
	}
}

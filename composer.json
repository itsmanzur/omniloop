{
	"name": "omniloop/omniloop",
	"description": "Faceted product and post loop for the Divi 5 Visual Builder.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"OmniLoop\\Engine\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OmniLoop\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
